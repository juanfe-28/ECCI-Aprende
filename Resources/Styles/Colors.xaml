<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Colores base de .NET MAUI -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">#00000000</Color>

    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray800">#1F2937</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#030712</Color>

    <!-- Paleta institucional ECCI Aprende -->
    <Color x:Key="Primary">#1E3A8A</Color>
    <Color x:Key="PrimaryDark">#172554</Color>
    <Color x:Key="PrimaryLight">#DBEAFE</Color>
    <Color x:Key="PrimaryDarkText">#172554</Color>

    <Color x:Key="Secondary">#F59E0B</Color>
    <Color x:Key="SecondaryDarkText">#475569</Color>
    <Color x:Key="Tertiary">#0284C7</Color>

    <!-- Compatibilidad con los estilos originales -->
    <Color x:Key="OffBlack">#121212</Color>
    <Color x:Key="MidnightBlue">#1E3A8A</Color>
    <Color x:Key="Magenta">#F59E0B</Color>

    <!-- Colores propios de la interfaz -->
    <Color x:Key="Accent">#F59E0B</Color>
    <Color x:Key="PageBackground">#F8FAFC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>

    <!-- Estados -->
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="Warning">#B45309</Color>
    <Color x:Key="Error">#DC2626</Color>
    <Color x:Key="Info">#0284C7</Color>

</ResourceDictionary>
